{
  "description": "Sample test data file for various testing scenarios",
  "version": "1.0.0",
  "testUsers": [
    {
      "id": 1,
      "username": "testuser1",
      "email": "test1@example.com",
      "firstName": "John",
      "lastName": "Doe",
      "role": "admin",
      "active": true
    },
    {
      "id": 2,
      "username": "testuser2",
      "email": "test2@example.com",
      "firstName": "Jane",
      "lastName": "Smith",
      "role": "user",
      "active": true
    },
    {
      "id": 3,
      "username": "testuser3",
      "email": "test3@example.com",
      "firstName": "Bob",
      "lastName": "Johnson",
      "role": "user",
      "active": false
    }
  ],
  "testData": {
    "strings": [
      "Hello, World!",
      "Test string with special chars: !@#$%^&*()",
      "Multi\nline\nstring",
      "Unicode: 你好世界 🌍",
      ""
    ],
    "numbers": [
      0,
      1,
      -1,
      3.14159,
      -2.5,
      1000000,
      0.0001
    ],
    "booleans": [
      true,
      false
    ],
    "nullValues": [
      null
    ],
    "arrays": {
      "empty": [],
      "numbers": [1, 2, 3, 4, 5],
      "strings": ["alpha", "beta", "gamma"],
      "mixed": [1, "two", 3.0, true, null]
    },
    "objects": {
      "empty": {},
      "simple": {
        "key": "value",
        "count": 42
      },
      "nested": {
        "level1": {
          "level2": {
            "level3": {
              "message": "Deep nesting"
            }
          }
        }
      }
    }
  },
  "apiEndpoints": {
    "base": "https://api.example.com",
    "endpoints": {
      "users": "/api/v1/users",
      "posts": "/api/v1/posts",
      "comments": "/api/v1/comments",
      "login": "/api/v1/auth/login",
      "logout": "/api/v1/auth/logout"
    }
  },
  "testScenarios": [
    {
      "scenario": "Valid login",
      "input": {
        "username": "testuser1",
        "password": "Password123!"
      },
      "expectedOutput": {
        "success": true,
        "statusCode": 200
      }
    },
    {
      "scenario": "Invalid login",
      "input": {
        "username": "testuser1",
        "password": "wrongpassword"
      },
      "expectedOutput": {
        "success": false,
        "statusCode": 401
      }
    },
    {
      "scenario": "Missing credentials",
      "input": {
        "username": "",
        "password": ""
      },
      "expectedOutput": {
        "success": false,
        "statusCode": 400
      }
    }
  ],
  "configuration": {
    "timeout": 5000,
    "retries": 3,
    "environment": "test",
    "debug": true
  }
}
